# Copy this file to .env and adjust values for your environment.
# All variables use the EIDON_ prefix.
# Defaults are defined in src/eidon/config.py.

# --- Paths ---
# EIDON_MODEL_DIR=models
# EIDON_GALLERY_PATH=data/gallery/gallery.npz

# --- Model files (inside MODEL_DIR) ---
# EIDON_DET_MODEL_PACK=buffalo_s
# EIDON_DET_MODEL_NAME=det_500m.onnx
# EIDON_REC_MODEL_NAME=w600k_mbf.onnx

# --- Recognition ---
# EIDON_SIMILARITY_THRESHOLD=0.40
# EIDON_DET_SIZE_W=640
# EIDON_DET_SIZE_H=640

# --- Webcam ---
# EIDON_WEBCAM_INDEX=0
# EIDON_INFERENCE_SKIP_FRAMES=2

# --- Performance ---
# EIDON_MAX_WORKERS=4
# EIDON_BATCH_SIZE=8

# --- API auth (leave blank to disable) ---
# EIDON_API_KEY=your-secret-key

# --- Logging ---
# EIDON_LOG_LEVEL=INFO
